---
import type { BenchmarkRun } from "../data/benchmarkRuns.ts";
import { attemptDuration, outcomeExplanation } from "../data/benchmarkRuns.ts";
import { fmtOutcome, fmtArtifactSource, fmtKctCheck, fmtCliDrc, fmtDiffPairs } from "../data/benchmarkFormat.ts";
import { deepPcbReferenceFor } from "../data/deepPcbReference.ts";
interface Props { run: BenchmarkRun }
const { run } = Astro.props;
const r = run.report;
const root = "https://github.com/rjwalters/kicad-tools/blob/main/benchmarks/external/results/";
const rawUrl = root + run.path.split("/").map(encodeURIComponent).join("/");
const input = r.pre_route_completion;
// Vendor figures are already presented separately in the historical reference
// section. Do not mix the harness's mirrored vendor note into local diagnostics.
const localNotes = (r.notes ?? []).filter(note => !note.startsWith("DeepPCB published reference:"));
const measuredLabel = r.route_outcome?.artifact_source === "router_output"
  ? "Measured final connectivity" : r.route_outcome?.artifact_source === "fallback_input"
    ? "Measured fallback-input connectivity" : "Measured connectivity (artifact origin unknown)";
---
<article class="run" aria-label={`${r.board_id} ${r.protocol} ${r.generated_at}`}>
  <h3>{deepPcbReferenceFor(r.board_id)?.name ?? r.board_id} · <code>{r.protocol}</code></h3>
  <p>Evidence recorded <time datetime={r.generated_at}>{r.generated_at}</time> · Tested tool <code>{r.tool_commit}</code></p>
  <p><strong>Outcome: {fmtOutcome(r)}</strong>. {outcomeExplanation(r)}</p>
  <p>Measured artifact: <strong>{fmtArtifactSource(r)}</strong>.</p>
  <dl>
    <div><dt>Input connectivity before routing</dt><dd>{input ? `${input.connections_routed} of ${input.connections_total} (${input.completion_pct.toFixed(1)}%)` : "Not recorded"}</dd></div>
    <div><dt>Newly routed connections</dt><dd>{r.newly_routed_connections == null ? "Not recorded" : r.newly_routed_connections}</dd></div>
    <div><dt>{measuredLabel}</dt><dd>{r.completion.connections_routed} of {r.completion.connections_total} ({r.completion.completion_pct.toFixed(1)}%)</dd></div>
    <div><dt>Measured copper</dt><dd>{r.copper.via_count} vias · {r.copper.wirelength_mm.toFixed(2)} mm</dd></div>
    <div><dt>Attempt duration</dt><dd>{attemptDuration(r)}</dd></div>
    <div><dt>Design checks (kct check)</dt><dd>{fmtKctCheck(r)}</dd></div>
    <div><dt>Native KiCad DRC</dt><dd>{fmtCliDrc(r)}</dd></div>
    <div><dt>Differential pairs</dt><dd>{fmtDiffPairs(r)}</dd></div>
  </dl>
  <details>
    <summary>Reason, diagnostics and reproduction</summary>
    <p>{r.route_outcome?.reason ?? "No explicit outcome reason was recorded."}</p>
    <p>Exit code: {r.route_outcome?.exit_code ?? "not recorded"}.</p>
    {r.kct_check?.note && <p>Design-check diagnostic: {r.kct_check.note}</p>}
    {r.kicad_cli_drc?.note && <p>Native DRC diagnostic: {r.kicad_cli_drc.note}</p>}
    {localNotes.length ? <ul>{localNotes.map(note => <li>{note}</li>)}</ul> : <p>No additional diagnostics were recorded.</p>}
    <p>Board source: {r.board_source ?? "not recorded"}; board revision: <code>{r.board_commit ?? "not recorded"}</code>.</p>
    <p>Reproduce with the recorded tool and board revisions. The collection writeup records actual commands, budgets, environment and acquisition limitations.</p>
    <a href={root + run.collection + "/README.md"}>Collection writeup and reproduction</a>
  </details>
  <p><a href={rawUrl}>Raw report JSON</a></p>
</article>
<style>
  .run { border: 1px solid var(--border); border-radius: 6px; padding: 1.2rem; margin: 1rem 0; overflow-wrap: anywhere; }
  h3 { margin: 0; } p { color: var(--muted); }
  dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem 1.5rem; }
  dt { color: var(--muted); font-size: 0.9rem; } dd { margin: 0.25rem 0; }
  a { color: var(--accent); } summary { cursor: pointer; color: var(--accent); }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 600px) { dl { grid-template-columns: 1fr; } }
</style>
