(pcb back_side_board
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "kicad-tools")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0
        39500.0 500.0
        500.0 500.0
        500.0 29500.0
        39500.0 29500.0
        39500.0 500.0
      )
    )
    (rule
      (width 200.0)
      (clearance 200.0)
      (clearance 200.0 (type default_smd))
      (clearance 200.0 (type smd_smd))
    )
  )
  (placement
    (component Package_TO_SOT_SMD:SOT-23
      (place U1 8000.0 8000.0 front 0)
    )
    (component Package_TO_SOT_SMD:SOT-23__back
      (place U3 28000.0 22000.0 back 180)
    )
    (component Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical__back
      (place J1 8000.0 20000.0 back 180)
    )
    (component Package_TO_SOT_SMD:SOT-23__back
      (place U2 28000.0 8000.0 back 210)
    )
  )
  (library
    (image Package_TO_SOT_SMD:SOT-23
      (pin Rect[T]Pad_1475.0x600.0_um 1 -937.5 -950.0)
      (pin Rect[T]Pad_1475.0x600.0_um 2 -937.5 950.0)
      (pin Rect[T]Pad_1475.0x600.0_um 3 937.5 0.0)
    )
    (image Package_TO_SOT_SMD:SOT-23__back
      (pin Rect[T]Pad_1475.0x600.0_um 1 937.5 950.0)
      (pin Rect[T]Pad_1475.0x600.0_um 2 937.5 -950.0)
      (pin Rect[T]Pad_1475.0x600.0_um 3 -937.5 0.0)
    )
    (image Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical__back
      (pin Round[A]Pad_1700.0x1700.0_Drill1000.0_um 1 -0.0 0.0)
      (pin Round[A]Pad_1700.0x1700.0_Drill1000.0_circleddc717fa_um 2 -0.0 -2540.0)
    )
    (padstack Rect[T]Pad_1475.0x600.0_um
      (shape (rect F.Cu -737.5 -300.0 737.5 300.0))
      (attach off)
    )
    (padstack Round[A]Pad_1700.0x1700.0_Drill1000.0_um
      (shape (rect F.Cu -850.0 -850.0 850.0 850.0))
      (shape (rect B.Cu -850.0 -850.0 850.0 850.0))
      (attach off)
    )
    (padstack Round[A]Pad_1700.0x1700.0_Drill1000.0_circleddc717fa_um
      (shape (circle F.Cu 1700.0 0.0 0.0))
      (shape (circle B.Cu 1700.0 0.0 0.0))
      (attach off)
    )
    (padstack Via[0-1]_Pad600_um
      (shape (circle F.Cu 600.0))
      (shape (circle B.Cu 600.0))
      (attach off)
    )
  )
  (network
    (net BB
      (pins
        U2-1
        U3-1
      )
    )
    (net FB
      (pins
        U1-1
        U2-2
      )
    )
    (net FT
      (pins
        J1-2
        U1-2
      )
    )
    (net TB
      (pins
        J1-1
        U3-2
      )
    )
    (class kicad_default
      BB
      FB
      FT
      TB
      (circuit
        (use_via Via[0-1]_Pad600_um)
      )
      (rule
        (width 200.0)
        (clearance 200.0)
      )
    )
  )
)