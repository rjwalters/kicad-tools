{
  "schema": "kct-fleet-router-protocol/v1",
  "issue": 6334,
  "parent": 5943,
  "pins": {
    "tracemaker": {
      "repo_url": "https://github.com/DingoOz/TraceMaker",
      "commit": "89ff58ca86b2104ac6c55ae8a5dc77e4ab3e8d00",
      "license_compat": "copyleft-ideas-only",
      "build": "cmake -S <checkout> -B <checkout>/build/cpu-only -DCMAKE_BUILD_TYPE=RelWithDebInfo -DTM_ENABLE_CUDA=OFF -DTM_BUILD_TESTS=OFF -DTM_WERROR=OFF -DTM_BUILD_PYTHON=OFF && cmake --build <checkout>/build/cpu-only --target tracemaker -j 2",
      "default_executable": "build/cpu-only/src/app/tracemaker",
      "command": "tracemaker route <in.kicad_pcb> -o <out.kicad_pcb> --work <tracemaker_work> --seed <seed> --threads <threads> --no-gpu --no-kb --json <summary.json>",
      "cli_verified_from": "src/app/main.cpp at the pinned commit (route subcommand options)",
      "learned_state": "--no-kb: the cross-run knowledge base is neither read nor written",
      "determinism_note": "upstream claims output is identical at any --threads under --work; not verified by this protocol",
      "build_environment": {
        "os": "Ubuntu 24.04",
        "cmake": "3.28",
        "compiler": "g++ 13 (the presets' g++-15 is not needed)",
        "system_packages": "Boost, Eigen3, SQLite3 and zstd development packages from the host (versions not recorded)",
        "scratch_prefix_deps": {
          "nlohmann_json": "v3.11.3 (-DJSON_BuildTests=OFF)",
          "CLI11": "v2.4.2 (-DCLI11_BUILD_TESTS=OFF -DCLI11_BUILD_EXAMPLES=OFF)"
        },
        "scratch_prefix_recipe": "clone each at the tag, cmake -S <src> -B <src>/b -DCMAKE_INSTALL_PREFIX=/tmp/fleet/prefix && cmake --install <src>/b; then configure TraceMaker with -DCMAKE_PREFIX_PATH=/tmp/fleet/prefix. Nothing is installed on the host."
      }
    },
    "fastroute": {
      "repo_url": "https://github.com/parisxmas/fastroute",
      "commit": "e5d52c4544795422b8b28077acc0605fdf11265a",
      "license_compat": "copyleft-ideas-only",
      "build": "cargo build --release -p fastroute --locked -j 2",
      "default_executable": "target/release/fastroute",
      "command": "fastroute -de <board.dsn> -do <board.ses> --router.autorouter.max_threads=<threads> --router.optimizer.max_threads=<threads> --report=<report.json>",
      "cli_verified_from": "`fastroute --help` of the pinned build (0.1.7)",
      "interchange": "DSN from kicad_tools.export.dsn.KiCadToDSNExporter; SES merged back with kicad_tools.export.ses.SESToKiCadImporter into the normalized input",
      "partial_output_note": "fastroute rewrites the .ses with the best board so far, so a partial session exists at timeout; the row stays `timeout`"
    },
    "kct": {
      "command": "kct route <in.kicad_pcb> -o <out.kicad_pcb> --backend cpp --seed <seed>",
      "requires": "C++ backend built in the active worktree (`uv run kct build-native`); otherwise the row is tool-failure/native-backend"
    }
  },
  "budgets": {
    "wall_cap_s": 600,
    "threads": 1,
    "seed": 1,
    "tracemaker_work": 50000000
  },
  "stripping_policy": {
    "name": "strip-tracks-and-vias",
    "removes": [
      "segment",
      "arc",
      "via"
    ],
    "scope": "top-level children of (kicad_pcb ...) only; nested forms such as arcs in zone outlines are untouched",
    "preserves": [
      "footprints and pads (placement, rotation, side, pad nets)",
      "board outline",
      "zones (keepout and copper; fills are recomputed by the referee)",
      "rule areas",
      "layer stack and setup",
      "net table",
      "graphics and text"
    ],
    "applies_to": "every included board identically; fixed-placement baseline only (preserved-copper, fanout and length-tuning variants are separate, not mixed into baseline rows)"
  },
  "referee": {
    "drc": "kicad-cli pcb drc --refill-zones --severity-all --all-track-errors --format json --units mm --save-board",
    "manufacturing": "kct check engine (kicad_tools.benchmark.external.metrics.run_kct_check, manufacturer jlcpcb, board's copper layer count)",
    "sync": "kct validate --sync -s <frozen .kicad_sch> -p <graded .kicad_pcb> --format json",
    "rules": "every output is graded in a fresh directory beside copies of the frozen .kicad_pro and .kicad_dru; tool-emitted rule files are never used",
    "unavailable": "a referee that does not run is recorded as ran=false / null, never 0, and blocks clean_pass=true"
  },
