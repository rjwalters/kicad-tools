kct_version: '1.0'
project:
  name: 8 MiB SDRAM exerciser
  revision: B
  description: Real STM32F429ZIT6 and IS42S16400J SDR SDRAM bench demo, 96 MHz MCU
    / 48 MHz memory clock, standalone regulated 5 V input, SWD programming and UART/status
    LED memory test. Hardware testing pending.
  artifacts:
    pcb: output/matchgroup_test.kicad_pcb
    pcb_routed: output/matchgroup_test_routed.kicad_pcb
    schematic: output/matchgroup_test.kicad_sch
    net_class_map_sidecar: output/net_class_map.json
requirements:
  manufacturing:
    target_fab: jlcpcb
    layers:
      preferred: 6
    assembly: smt
