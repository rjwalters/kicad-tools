(version 1)

# BEGIN kct fab floors (Issue #4600) -- managed, do not edit
(rule "Trace Width - jlcpcb"
  (condition "A.Type == 'track'")
  (constraint track_width (min 0.1016mm)))
(rule "Clearance - jlcpcb"
  (constraint clearance (min 0.1016mm)))
(rule "Silk to Pad - jlcpcb"
  (condition "A.Type == 'Pad' || B.Type == 'Pad'")
  (constraint silk_clearance (min 0.15mm)))
(rule "SMD Pad Clearance - jlcpcb"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net && A.Reference != B.Reference")
  (constraint clearance (min 0.15mm)))
(rule "PTH Hole to Track - jlcpcb"
  (condition "(A.Pad_Type == 'Through-hole' && B.Type == 'Track') || (B.Pad_Type == 'Through-hole' && A.Type == 'Track')")
  (constraint hole_clearance (min 0.28mm)))
(rule "Inner PTH Hole to Copper - jlcpcb"
  (layer inner)
  (condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.3mm)))
(rule "Via Drill - jlcpcb"
  (condition "A.Type == 'via' && A.Via_Type != 'Micro'")
  (constraint hole_size (min 0.2mm)))
(rule "Via Diameter - jlcpcb"
  (condition "A.Type == 'via' && A.Via_Type != 'Micro'")
  (constraint via_diameter (min 0.45mm)))
(rule "Annular Ring - jlcpcb"
  (condition "A.Via_Type != 'Micro'")
  (constraint annular_width (min 0.1mm)))
(rule "PTH Annular Ring - jlcpcb"
  (condition "A.Type == 'pad'")
  (constraint annular_width (min 0.15mm)))
(rule "Copper to Edge - jlcpcb"
  (constraint edge_clearance (min 0.3mm)))
(rule "Hole to Edge - jlcpcb"
  (condition "(A.Type == 'via' || A.Type == 'pad') && B.Layer == 'Edge.Cuts'")
  (constraint physical_hole_clearance (min 0.4mm)))
(rule "Silkscreen Width - jlcpcb"
  (condition "A.Type == 'text' && A.Layer == 'F.Silkscreen'")
  (constraint text_thickness (min 0.15mm)))
(rule "Silkscreen Height - jlcpcb"
  (condition "A.Type == 'text' && A.Layer == 'F.Silkscreen'")
  (constraint text_height (min 1.0mm)))

(rule "Reviewed clearance - Audio"
  (condition "(A.NetClass == 'Audio' || B.NetClass == 'Audio') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference)")
  (constraint clearance (min 0.15mm)))

(rule "Reviewed clearance - Debug"
  (condition "(A.NetClass == 'Debug' || B.NetClass == 'Debug') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference)")
  (constraint clearance (min 0.15mm)))

(rule "Reviewed clearance - Differential"
  (condition "(A.NetClass == 'Differential' || B.NetClass == 'Differential') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference)")
  (constraint clearance (min 0.15mm)))

(rule "Reviewed clearance - Digital"
  (condition "(A.NetClass == 'Digital' || B.NetClass == 'Digital') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference)")
  (constraint clearance (min 0.15mm)))

(rule "Reviewed clearance - Clock"
  (condition "(A.NetClass == 'Clock' || B.NetClass == 'Clock') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference)")
  (constraint clearance (min 0.2mm)))

(rule "Reviewed clearance - HighCurrentSignal"
  (condition "(A.NetClass == 'HighCurrentSignal' || B.NetClass == 'HighCurrentSignal') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference)")
  (constraint clearance (min 0.2mm)))

(rule "Reviewed clearance - Power"
  (condition "(A.NetClass == 'Power' || B.NetClass == 'Power') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference)")
  (constraint clearance (min 0.2mm)))
# END kct fab floors

# BEGIN kct keepout rules (Issue #6039) -- managed, do not edit
# Generated from the board's keepout rule areas, board-level (Issue #6039)
# and footprint-embedded (Issue #6087).
# kicad-cli 10.0.1 does not enforce rule areas on its own; these
# explicit intersectsArea rules make `kicad-cli pcb drc` report them.
(rule "kct keepout Remove isolated pour fragment 2 [620ac875-01ab-47a9-90d0-696b6efc2848]"
  (layer "F.Cu")
  (condition "A.intersectsArea('620ac875-01ab-47a9-90d0-696b6efc2848')")
  (constraint disallow zone))
(rule "kct keepout Remove isolated pour fragment 3 [6c093016-a51e-43cd-a49d-c47de72e7bb9]"
  (layer "F.Cu")
  (condition "A.intersectsArea('6c093016-a51e-43cd-a49d-c47de72e7bb9')")
