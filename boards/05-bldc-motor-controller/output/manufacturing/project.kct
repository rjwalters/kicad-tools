decisions:
- date: '2026-09-09'
  phase: schematic
  topic: Repair invalid original motor-control circuit
  choice: Real integrated DRV8313 triple bridge, ATmega328P, TPS7A1650; conservative
    small-motor demonstrator
  rationale: Original DRV8301 regulator/charge-pump/buck pins and procurement invalid,
    issue4993. Datasheet pin maps and native or TI-derived physical land patterns.
progress:
  phase: manufacturing
  phases:
    schematic:
      status: completed
      checklist:
      - '[x] Native ERC and label LVS clean'
      - '[x] Verified component identities and support circuit'
    layout:
      status: completed
      checklist:
      - '[x] Physical component placement'
      - '[x] Native copper/DRC/manufacturing verification'
