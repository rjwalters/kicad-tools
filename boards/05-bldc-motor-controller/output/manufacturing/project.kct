kct_version: '1.0'
project:
  name: Sensored BLDC Controller
  revision: B
  author: kicad-tools
  description: 'Small sensored BLDC motor controller: ATmega328P-AU, DRV8313PWPR and
    TPS7A1650DGNR, complete ISP/power/current-monitor circuit.'
  artifacts:
    schematic: output/bldc_controller.kicad_sch
    pcb: output/bldc_controller.kicad_pcb
    routed: output/bldc_controller_routed.kicad_pcb
intent:
  summary: Demonstrate real motor commutation, power routing, thermal ground and complete
    manufacturing artifacts.
requirements:
  electrical:
    input_voltage:
      min: 12
      max: 24
      unit: V
    motor_current:
      continuous: 0.5
      peak: 1.0
      unit: A
    notes: Initial bench target, pending physical motor/thermal validation. Current-limited
      regulated supply, 30mA maximum total 5V load; 20mA Hall allocation. Firmware
      25% duty cap.
  mechanical:
    board_size:
      width: 70
      height: 90
      unit: mm
  manufacturing:
    layers:
      preferred: 4
    min_trace: 0.15mm
    min_space: 0.127mm
    min_drill: 0.2mm
    copper_weight: 1oz
    target_fab: jlcpcb
