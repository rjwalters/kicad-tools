  (condition "A.intersectsCourtyard('C10') && B.intersectsCourtyard('C10') && ((A.NetName == '+3V3' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'GND' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == '+3V3' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'GND' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.15mm)))
