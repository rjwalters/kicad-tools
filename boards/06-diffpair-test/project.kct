kct_version: '1.0'
project:
  name: Four-channel LVDS link demonstrator
  revision: C
  description: Real SN65LVDS1DR drivers and SN65LVDS2DR receivers, four terminated
    differential links. External regulated 3.3V and LVTTL stimulus required. No firmware.
  artifacts:
    pcb: output/diffpair_test.kicad_pcb
    pcb_routed: output/diffpair_test_routed.kicad_pcb
    schematic: output/diffpair_test.kicad_sch
requirements:
  manufacturing:
    target_fab: jlcpcb-tier1
    layers:
      preferred: 4
    assembly: smt
