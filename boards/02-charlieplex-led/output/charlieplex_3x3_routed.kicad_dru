(version 1)

# BEGIN kct fab floors (Issue #4600) -- managed, do not edit
(rule "Trace Width - jlcpcb"
  (condition "A.Type == 'track'")
  (constraint track_width (min 0.127mm)))
(rule "Clearance - jlcpcb"
  (constraint clearance (min 0.127mm)))
(rule "Silk to Pad - jlcpcb"
  (condition "A.Type == 'Pad' || B.Type == 'Pad'")
  (constraint silk_clearance (min 0.15mm)))
(rule "SMD Pad Clearance - jlcpcb"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net && A.Reference != B.Reference")
  (constraint clearance (min 0.15mm)))
(rule "PTH Hole to Track - jlcpcb"
  (condition "(A.Pad_Type == 'Through-hole' && B.Type == 'Track') || (B.Pad_Type == 'Through-hole' && A.Type == 'Track')")
  (constraint hole_clearance (min 0.28mm)))
(rule "Inner PTH Hole to Copper - jlcpcb"
  (layer inner)
  (condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.3mm)))
(rule "Via Drill - jlcpcb"
  (condition "A.Type == 'via' && A.Via_Type != 'Micro'")
  (constraint hole_size (min 0.3mm)))
(rule "Max Hole Size - jlcpcb"
  (constraint hole_size (max 6.3mm)))
(rule "Via Diameter - jlcpcb"
  (condition "A.Type == 'via' && A.Via_Type != 'Micro'")
  (constraint via_diameter (min 0.6mm)))
(rule "Annular Ring - jlcpcb"
  (condition "A.Via_Type != 'Micro'")
  (constraint annular_width (min 0.15mm)))
(rule "PTH Annular Ring - jlcpcb"
  (condition "A.Type == 'pad'")
  (constraint annular_width (min 0.18mm)))
(rule "Copper to Edge - jlcpcb"
  (constraint edge_clearance (min 0.3mm)))
(rule "Hole to Edge - jlcpcb"
  (condition "(A.Type == 'via' || A.Type == 'pad') && B.Layer == 'Edge.Cuts'")
  (constraint physical_hole_clearance (min 0.5mm)))
(rule "Silkscreen Width - jlcpcb"
  (condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
  (constraint text_thickness (min 0.15mm)))
(rule "Silkscreen Height - jlcpcb"
  (condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
  (constraint text_height (min 1.0mm)))
(rule "Ampacity Min Width (Power 0.1A, external) - jlcpcb"
  (condition "(A.NetName == 'VCC') && A.Type == 'track' && (A.Layer == 'F.Cu' || A.Layer == 'B.Cu')")
  (constraint track_width (min 0.0125mm)))

(rule "Reviewed clearance - Audio"
  (condition "(A.NetClass == 'Audio' || B.NetClass == 'Audio') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.15mm)))

(rule "Reviewed clearance - Debug"
  (condition "(A.NetClass == 'Debug' || B.NetClass == 'Debug') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.15mm)))

(rule "Reviewed clearance - Digital"
  (condition "(A.NetClass == 'Digital' || B.NetClass == 'Digital') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.15mm)))

(rule "Reviewed clearance - Clock"
  (condition "(A.NetClass == 'Clock' || B.NetClass == 'Clock') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.2mm)))

(rule "Reviewed clearance - Power"
  (condition "(A.NetClass == 'Power' || B.NetClass == 'Power') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.2mm)))
# END kct fab floors

# BEGIN kct attach-zone router-class exemptions (Issue #8048) -- managed, do not edit
# Copper attaching to a rated part is spaced by that part's own pin pitch:
# inside a footprint's courtyard, between its pad nets, the router's net-class
# floor drops to the board-wide base clearance. Designer minima are untouched.
(rule "kct attach zone - C1"
  (condition "A.intersectsCourtyard('C1') && B.intersectsCourtyard('C1') && ((A.NetName == 'GND' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'VCC' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'GND' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'VCC' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - C2"
  (condition "A.intersectsCourtyard('C2') && B.intersectsCourtyard('C2') && ((A.NetName == 'GND' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'VCC' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'GND' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'VCC' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - D1"
  (condition "A.intersectsCourtyard('D1') && B.intersectsCourtyard('D1') && ((A.NetName == 'NODE_A' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_B' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'NODE_A' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_B' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - D2"
  (condition "A.intersectsCourtyard('D2') && B.intersectsCourtyard('D2') && ((A.NetName == 'NODE_A' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_B' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'NODE_A' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_B' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - D3"
  (condition "A.intersectsCourtyard('D3') && B.intersectsCourtyard('D3') && ((A.NetName == 'NODE_A' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_C' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'NODE_A' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_C' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - D4"
  (condition "A.intersectsCourtyard('D4') && B.intersectsCourtyard('D4') && ((A.NetName == 'NODE_A' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_C' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'NODE_A' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_C' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - D5"
  (condition "A.intersectsCourtyard('D5') && B.intersectsCourtyard('D5') && ((A.NetName == 'NODE_A' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_D' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'NODE_A' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_D' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - D6"
  (condition "A.intersectsCourtyard('D6') && B.intersectsCourtyard('D6') && ((A.NetName == 'NODE_A' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_D' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'NODE_A' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_D' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - D7"
  (condition "A.intersectsCourtyard('D7') && B.intersectsCourtyard('D7') && ((A.NetName == 'NODE_B' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_C' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'NODE_B' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_C' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - D8"
  (condition "A.intersectsCourtyard('D8') && B.intersectsCourtyard('D8') && ((A.NetName == 'NODE_B' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_C' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'NODE_B' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_C' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - D9"
  (condition "A.intersectsCourtyard('D9') && B.intersectsCourtyard('D9') && ((A.NetName == 'NODE_B' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_D' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'NODE_B' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_D' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - J1"
  (condition "A.intersectsCourtyard('J1') && B.intersectsCourtyard('J1') && ((A.NetName == 'GND') || (A.NetName == 'VCC')) && ((B.NetName == 'GND') || (B.NetName == 'VCC'))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - J2"
  (condition "A.intersectsCourtyard('J2') && B.intersectsCourtyard('J2') && ((A.NetName == 'GND') || (A.NetName == 'ISP_SCK') || (A.NetName == 'LINE_C') || (A.NetName == 'LINE_D') || (A.NetName == 'RESET') || (A.NetName == 'VCC')) && ((B.NetName == 'GND') || (B.NetName == 'ISP_SCK') || (B.NetName == 'LINE_C') || (B.NetName == 'LINE_D') || (B.NetName == 'RESET') || (B.NetName == 'VCC'))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - R1"
  (condition "A.intersectsCourtyard('R1') && B.intersectsCourtyard('R1') && ((A.NetName == 'LINE_A' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_A' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'LINE_A' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_A' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - R2"
  (condition "A.intersectsCourtyard('R2') && B.intersectsCourtyard('R2') && ((A.NetName == 'LINE_B' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_B' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'LINE_B' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_B' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - R3"
  (condition "A.intersectsCourtyard('R3') && B.intersectsCourtyard('R3') && ((A.NetName == 'LINE_C' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_C' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'LINE_C' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_C' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - R4"
  (condition "A.intersectsCourtyard('R4') && B.intersectsCourtyard('R4') && ((A.NetName == 'LINE_D' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'NODE_D' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'LINE_D' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'NODE_D' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - R5"
  (condition "A.intersectsCourtyard('R5') && B.intersectsCourtyard('R5') && ((A.NetName == 'RESET' && (A.Type == 'Via' || A.Layer == 'F.Cu')) || (A.NetName == 'VCC' && (A.Type == 'Via' || A.Layer == 'F.Cu'))) && ((B.NetName == 'RESET' && (B.Type == 'Via' || B.Layer == 'F.Cu')) || (B.NetName == 'VCC' && (B.Type == 'Via' || B.Layer == 'F.Cu')))")
  (constraint clearance (min 0.127mm)))
(rule "kct attach zone - U1"
  (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1') && ((A.NetName == 'GND') || (A.NetName == 'ISP_SCK') || (A.NetName == 'LINE_A') || (A.NetName == 'LINE_B') || (A.NetName == 'LINE_C') || (A.NetName == 'LINE_D') || (A.NetName == 'RESET') || (A.NetName == 'VCC')) && ((B.NetName == 'GND') || (B.NetName == 'ISP_SCK') || (B.NetName == 'LINE_A') || (B.NetName == 'LINE_B') || (B.NetName == 'LINE_C') || (B.NetName == 'LINE_D') || (B.NetName == 'RESET') || (B.NetName == 'VCC'))")
  (constraint clearance (min 0.127mm)))
# END kct attach-zone router-class exemptions
