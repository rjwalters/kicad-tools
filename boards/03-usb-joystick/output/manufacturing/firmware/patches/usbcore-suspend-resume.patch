+// BEGIN kicad-tools USB clock state machine (issue #5251)
+// Called with interrupts disabled (ISR or poll's saved-SREG critical section).
+static void USB_CancelClockResume()
+{
+	UDIEN = (UDIEN & ~(1<<WAKEUPE)) | (1<<SUSPE);
+	_usbClockResumePending = false;
+	_usbSuspendState = 0;
+}
+
+static void USB_SuspendClock()
+{
+	UDIEN = (UDIEN & ~(1<<SUSPE)) | (1<<WAKEUPE);
+	// Acknowledge while the USB clocks are still running.
+	UDINT = 0x7D & ~((1<<WAKEUPI) | (1<<SUSPI));
+	_usbSuspendState = (1<<SUSPI);
+	_usbClockResumePending = false;
+	USB_ClockDisable();
+}
+
+static void USB_RequestClockResume()
+{
+	// Leave WAKEUPI pending until poll restores USB clock inputs (datasheet
+	// 22.18.1). Mask both events while the PLL locks; flags remain latched.
+	UDIEN &= ~((1<<WAKEUPE) | (1<<SUSPE));
+	_usbSuspendState = (1<<SUSPI);
+	_usbClockResumePending = true;
+	PLLCSR |= (1<<PLLE);
+}
+
+static void USB_PollClockResume()
+{
+	uint8_t savedSREG = SREG;
+	cli();
+	if (_usbClockResumePending && (PLLCSR & (1<<PLOCK)))
+	{
+		// This is resume, not attach/reset: the regulator, divider and USB
+		// controller remain configured. PLOCK qualifies the restarted PLL.
+#if defined(OTGPADE)
+		USBCON = (USBCON & ~(1<<FRZCLK)) | (1<<OTGPADE);
+#else
+		USBCON &= ~(1<<FRZCLK);
+#endif
+		UDINT = 0x7D & ~(1<<WAKEUPI);
+		_usbClockResumePending = false;
+		// Preserve any later suspend/reset event for the normal ISR. Do
+		// not expose a sendable state before that event has been serviced.
+		if (UDINT & ((1<<SUSPI) | (1<<EORSTI)))
+		{
+			_usbSuspendState = (1<<SUSPI);
+			if (UDINT & (1<<EORSTI))
+				_usbConfiguration = 0;
+		}
+		else
+			_usbSuspendState = (1<<WAKEUPI);
+		UDIEN = (UDIEN & ~(1<<WAKEUPE)) | (1<<SUSPE);
+	}
+	SREG = savedSREG;
+}
+// END kicad-tools USB clock state machine
+
