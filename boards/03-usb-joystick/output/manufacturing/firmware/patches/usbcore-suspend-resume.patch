--- USBCore.cpp
+++ USBCore.cpp
@@ -88,6 +88,11 @@
 volatile u8 _usbConfiguration = 0;
 volatile u8 _usbCurrentStatus = 0; // meaning of bits see usb_20.pdf, Figure 9-4. Information Returned by a GetStatus() Request to a Device
 volatile u8 _usbSuspendState = 0; // copy of UDINT to check SUSPI and WAKEUPI bits
+// kicad-tools issue #5000: deferred USB PLL restart request, serviced by
+// USBDevice_::poll() from the main loop instead of from USB_GEN_vect. See
+// the comment at the WAKEUPI branch below for why USB_ClockEnable() must
+// never be called directly from that ISR.
+static volatile bool _usbClockResumePending = false;
 
 static inline void WaitIN(void)
 {
@@ -786,9 +791,16 @@
 	{
 		UDIEN = (UDIEN & ~(1<<WAKEUPE)) | (1<<SUSPE); // Disable interrupts for WAKEUP and enable interrupts for SUSPEND
 
-		//TODO
-		// WAKEUPI shall be cleared by software (USB clock inputs must be enabled before).
-		//USB_ClockEnable();
+		// kicad-tools issue #5000: WAKEUPI shall be cleared by software (USB
+		// clock inputs must be enabled before). The upstream TODO called
+		// USB_ClockEnable() directly here, but that function busy-waits on
+		// PLOCK and then calls delay(1); delay() spins on millis(), which
+		// only advances via Timer0's own ISR. Global interrupts are cleared
+		// for the duration of *this* ISR (no ISR_NOBLOCK / sei() in scope),
+		// so Timer0 could never fire and delay(1) would hang forever --
+		// deferring the actual clock restart to USBDevice_::poll(), which
+		// runs in the main loop with interrupts enabled, avoids that deadlock.
+		_usbClockResumePending = true;
 		UDINT &= ~(1<<WAKEUPI);
 		_usbSuspendState = (_usbSuspendState & ~(1<<SUSPI)) | (1<<WAKEUPI);
 	}
@@ -796,8 +808,11 @@
 	{
 		UDIEN = (UDIEN & ~(1<<SUSPE)) | (1<<WAKEUPE); // Disable interrupts for SUSPEND and enable interrupts for WAKEUP
 
-		//TODO
-		//USB_ClockDisable();
+		// kicad-tools issue #5000: USB_ClockDisable() only writes USBCON /
+		// PLLCSR -- no blocking wait, no delay() -- so unlike
+		// USB_ClockEnable() it is safe to call directly from this ISR.
+		USB_ClockDisable();
+		_usbClockResumePending = false;
 
 		UDINT &= ~((1<<WAKEUPI) | (1<<SUSPI)); // clear any already pending WAKEUP IRQs and the SUSPI request
 		_usbSuspendState = (_usbSuspendState & ~(1<<WAKEUPI)) | (1<<SUSPI);
@@ -827,6 +842,7 @@
 	_usbConfiguration = 0;
 	_usbCurrentStatus = 0;
 	_usbSuspendState = 0;
+	_usbClockResumePending = false;
 	USB_ClockEnable();
 
 	UDINT &= ~((1<<WAKEUPI) | (1<<SUSPI)); // clear already pending WAKEUP / SUSPEND requests
@@ -848,6 +864,16 @@
 
 void USBDevice_::poll()
 {
+	// kicad-tools issue #5000: service a clock-restart request the WAKEUPI
+	// branch of USB_GEN_vect deferred (see the comment there). This runs in
+	// the main loop with interrupts enabled, so USB_ClockEnable()'s PLOCK
+	// wait and delay(1) call behave as they do everywhere else they're used
+	// (USBDevice_::attach(), USBDevice_::wakeupHost()).
+	if (_usbClockResumePending)
+	{
+		_usbClockResumePending = false;
+		USB_ClockEnable();
+	}
 }
 
 bool USBDevice_::wakeupHost()
