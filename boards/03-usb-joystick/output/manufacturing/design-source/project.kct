kct_version: '1.0'
project:
  name: USB Joystick Controller
  revision: B
  created: 2025-01-08
  author: kicad-tools
  description: Real ATmega32U4-AU USB HID joystick hardware with protected USB-C bus
    power, crystal, AVR ISP, two filtered ADC axes and five active-low inputs.
  artifacts:
    schematic: output/usb_joystick.kicad_sch
    pcb: output/usb_joystick.kicad_pcb
    pcb_routed: output/usb_joystick_routed.kicad_pcb
intent:
  summary: 'A USB HID game controller featuring a 2-axis analog joystick,

    multiple tactile buttons, and USB-C connectivity. Designed to

    demonstrate kicad-tools autorouting capabilities with mixed

    signal types requiring different routing considerations.

    '
  use_cases:
  - Game controller
  - Autorouter demonstration
  - Mixed-signal routing example
  - USB HID device example
  interfaces:
  - name: USB_C
    type: usb_device
    description: USB Type-C for data and power
    protocol: USB 2.0 Full Speed
    voltage: 5V
    current_max: 100mA
  - name: JOYSTICK
    type: analog
    description: 2-axis analog joystick with button
    pins:
    - JOY_X
    - JOY_Y
    - JOY_BTN
    - VCC
    - GND
  - name: BUTTONS
    type: gpio
    description: Tactile button inputs
    pins:
    - BTN1
    - BTN2
    - BTN3
    - BTN4
  constraints:
  - USB differential pair must be length-matched
  - Crystal traces must be short and isolated
  - Analog signals separated from high-speed digital
  - 4-layer PCB with inner ground and VCC planes
requirements:
  electrical:
    input:
      voltage:
        nominal: 5V
      current:
        max: 100mA
    signals:
      usb:
        impedance: 90ohm_differential
        max_length: 50mm
      analog:
        bandwidth: DC-1kHz
        resolution: 10-bit ADC
  mechanical:
    dimensions:
      width: 80mm
      height: 60mm
  manufacturing:
    target_fab: jlcpcb-tier1
    layers:
      preferred: 4
    min_trace: 0.15mm
    min_space: 0.15mm
    min_via: 0.3mm
    assembly: mixed
  compliance:
    standards:
    - USB_2.0
    rohs: true
suggestions:
  components:
    mcu:
      preferred:
      - ATmega32U4
      rationale: Native USB, adequate I/O, actual TQFP-44 package with fixed manufacturer
        pinout
    usb_connector:
      preferred:
      - USB-C receptacle
      rationale: Modern, reversible, robust
    crystal:
      preferred:
      - ECS-80-12-33-JGN-TR
      rationale: Required for USB timing
  layout:
  - USB connector at board edge
  - MCU centered with room for breakout
  - Crystal close to MCU XTAL pins
  - Keep each supply bypass close to its corresponding VCC pin
  - Joystick connector opposite USB for ergonomics
  - Keep USB D+/D- traces short and matched
  - Route analog signals away from digital switching
  bom:
    preferred_vendors:
    - LCSC
    - Digikey
    cost_target: $5/board
  crystal:
    preferred:
    - ECS-80-12-33-JGN-TR
    rationale: 8MHz crystal for full-speed USB and low-VBUS operation; 12pF load target
